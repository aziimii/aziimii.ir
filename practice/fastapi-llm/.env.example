# Copy to .env (or export in your shell). All values are optional.

# Any OpenAI-compatible endpoint: OpenAI, Groq, Ollama, vLLM, OpenRouter...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Leave empty to run offline in echo mode (used by tests).
LLM_API_KEY=

LLM_TIMEOUT_SECONDS=30
RETRIEVAL_TOP_K=3

# Override to point at a different knowledge corpus directory.
# KNOWLEDGE_DIR=/path/to/knowledge
